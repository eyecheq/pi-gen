# EyeCheq Kiosk - V2 PCB Configuration
# Settings impact device functionality. Do not modify unless you understand what you are changing.
#
# Pi boot/config.txt reference
# http://rpf.io/configtxt

# Always run arm processor in 64-bit mode
arm_64bit=1

# Disable bluetooth/wifi, because our CM4s don't have the bluetooth/wifi chip
dtoverlay=disable-wifi
dtoverlay=disable-bt

# Disable Raspberry Pi Desktop splash screen
disable_splash=1

# Enable optional hardware interfaces
#dtparam=i2s=on
#dtparam=spi=on

# Additional overlays and parameters are documented /boot/overlays/README

# Enable audio (loads snd_bcm2835)
dtparam=audio=on

# Automatically load overlays for detected DSI displays
# This includes the Waveshare 7" screen for the Visual Acuity Snellen test
# display_auto_detect=1

# Automatically load initramfs files, if found
auto_initramfs=1

# Enable DRM VC4 V3D driver
max_framebuffers=2
dtoverlay=vc4-kms-v3d

# Don't have the firmware create an initial video= setting in cmdline.txt.
# Use the kernel's default instead.
disable_fw_kms_setup=1

# Disable compensation for displays with overscan
disable_overscan=1

# =============================================================================
# I2C Bus Configuration - V2 PCB
# =============================================================================
#
# V2 PCB Bus Layout:
#   GPIO2/3   - Power Button (gpio-shutdown + wake-from-halt)
#   I2C3      - Sensor Board on GPIO4 (SDA) / GPIO5 (SCL)
#   I2C4      - Motor + LED Control on GPIO6 (SDA) / GPIO7 (SCL)
#   I2C5      - CPU Fan on GPIO10 (SDA) / GPIO11 (SCL)
#   I2C6      - Air Quality Sensor on GPIO22 (SDA) / GPIO23 (SCL)
#
# I2C Device Reference:
#   I2C3: 0x44 (SHT40), 0x53 (LTR390), 0x68 (ICM-20948)
#   I2C4: 0x48 (ADS1015), 0x60 (PCA9685 LED), 0x70 (PCA9685 Motor)
#   I2C5: 0x2F (CPU Fan Controller)
#   I2C6: 0x69 (SEN54)
#
# NOTE: I2C1 (GPIO2/3) is NOT used on V2 PCB - GPIO3 is dedicated to power button
# =============================================================================

# === Power Button on GPIO3 ===
# Momentary button from GPIO3 to GND.
# - Press while running: initiates clean shutdown
# - Press while halted: wakes system (hardware feature of GPIO3)
# Debounce set to 100ms for responsive button feel
dtoverlay=gpio-shutdown,gpio_pin=3,active_low=1,gpio_pull=up,debounce=100

# === I2C3 - Sensor Board (GPIO4/5) ===
# Devices: SHT40 (0x44), LTR390 (0x53), ICM-20948 (0x68)
# Optional: VEML6075 (0x10), DHT20 (0x38)
dtoverlay=i2c3,pins_4_5

# === I2C4 - Motor + LED Control (GPIO6/7) ===
# Devices: ADS1015 ADC (0x48), PCA9685 LED PWM (0x60), PCA9685 Motor PWM (0x70)
dtoverlay=i2c4,pins_6_7

# === I2C5 - CPU Fan (GPIO10/11) ===
# Devices: Fan Controller (0x2F)
dtoverlay=i2c5,pins_10_11

# === I2C6 - Air Quality (GPIO22/23) ===
# Devices: SEN54 Environmental Sensor (0x69)
dtoverlay=i2c6,pins_22_23

# Run as fast as firmware / board allows
arm_boost=1

[cm4]

# Enable host mode on the 2711 built-in XHCI USB controller
otg_mode=1

[all]

enable_uart=1

# =============================================================================
# GPIO Configuration
# =============================================================================
# Abbreviations:
#   ip - Input, op - Output
#   a0-a5 - Alt0-Alt5
#   dh - Driving high, dl - Driving low
#   pu - Pull up, pd - Pull down, pn/np - No pull
# =============================================================================

# Enable Audio output and drive it high
gpio=24=op,dh

# Enable pull up resistor on GPIO-17 for Safety Bumper Switch
gpio=17=pu

# =============================================================================
# Display Configuration - Waveshare 7" DSI
# =============================================================================
ignore_lcd=1
dtparam=i2c_vc=on
# Debian 12 Bookworm
dtoverlay=vc4-kms-dsi-waveshare-panel,7_0_inchC,i2c0
# Snellen screen doesn't need touchscreen enabled
#dtoverlay=WS_xinchDSI_Touch,I2C_bus=10
